  30% { transform: scale(1.2); opacity: 1; }
}

/* ===== 角色卡片 ===== */
.role-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  background: var(--color-surface, rgba(255,255,255,0.92));
