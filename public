  align-items: center;
  gap: 4px;
}
.card-amount {
  padding: 4px 12px;
  font-size: 22px;
  font-weight: 700;
}
.card-note { padding: 0 12px 8px; font-size: 12px; opacity: .8; }
.card-status { padding: 0 12px 8px; font-size: 12px; }
.card-body { padding: 8px 12px; font-size: 14px; line-height: 1.5; }

/* 转账 */
.bubble-transfer { background: linear-gradient(135deg, #FFB344, #FFCC6B); color: #5C4033; }
.bubble-transfer .card-header { color: #5C4033; }
.bubble-transfer-receipt { background: #f5f5f5; }

/* 红包 */
