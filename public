  align-items: center;
  gap: 10px;
}
.gift-icon { font-size: 32px; }
.gift-text { font-size: 14px; }

/* 情诗 */
.bubble-poem {
  display: flex;
  gap: 8px;
  align-items: flex-start;
}
.poem-icon { font-size: 20px; flex-shrink: 0; }
.poem-text { font-size: 14px; line-height: 1.8; font-style: italic; }

/* 通话 */
.bubble-call {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  background: rgba(255,107,157,0.06);
  border-radius: 14px;
  font-size: 14px;
  color: var(--color-muted, #999);
}
.call-icon { font-size: 18px; }
.call-duration { margin-left: auto; font-size: 12px; }

/* 翻译 */
.bubble-translation {
  display: flex;
  gap: 6px;
  align-items: flex-start;
}
.trans-icon { font-size: 16px; flex-shrink: 0; }
.trans-text { font-size: 14px; }

/* 撤回 */
.bubble-recall {
  text-align: center;
  font-size: 12px;
  color: var(--color-muted, #999);
  padding: 4px 0;
  width: 100%;
}

/* 打字指示器 */
.typing-bubble {
  display: flex;
  gap: 4px;
  align-items: center;
  padding: 12px 16px !important;
}
.typing-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--color-muted, #999);
  animation: typing-bounce 1.4s infinite ease-in-out;
}
.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes typing-bounce {
