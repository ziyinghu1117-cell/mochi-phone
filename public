  var enhanceScheduled = false;

  /* ================================================================
   * Tiny helpers
   * ================================================================ */
  function $(id) { return document.getElementById(id); }

  function localEscape(t) {
    return String(t == null ? '' : t)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
