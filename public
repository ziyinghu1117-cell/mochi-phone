}
.voice-icon { font-size: 20px; flex-shrink: 0; }
.voice-bar {
  flex: 1;
  height: 4px;
  background: rgba(255,107,157,0.2);
  border-radius: 2px;
  overflow: hidden;
}
.voice-bar-fill {
  height: 100%;
  width: 60%;
  background: var(--color-primary, #FF6B9D);
  border-radius: 2px;
}
.voice-duration { font-size: 13px; flex-shrink: 0; }
.voice-text { font-size: 12px; color: var(--color-muted, #999); margin-top: 4px; width: 100%; }

/* 表情包 */
.bubble-sticker {
