      .then(function (r) { return r.json(); })
      .then(function (res) {
        if (res.code === 0 && res.data && res.data.loggedIn) {
          if (res.data.isAdmin) {
            var adminBtn = document.getElementById('adminEntryBtn');
            if (adminBtn) adminBtn.style.display = 'inline-block';
