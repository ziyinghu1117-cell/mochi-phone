.rp-greeting { padding: 8px 12px; font-size: 14px; }
.rp-footer { padding: 6px 12px; font-size: 11px; opacity: .7; border-top: 1px solid rgba(255,255,255,0.2); }

/* 外卖 */
.bubble-takeout { background: #fff; border: 1px solid #eee; }

/* 朋友圈 */
.bubble-moments { background: #fff; border: 1px solid #eee; }
.bubble-moments .card-header { background: rgba(255,107,157,0.05); }

/* HTML交互页沙箱 */
.bubble-html-sandbox {
  width: 100%;
  max-width: 320px;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid #e0e0e0;
  background: #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}
.html-sandbox-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
