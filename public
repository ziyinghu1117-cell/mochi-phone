  transition: all .2s;
}
.qq-room-mode-btn.active {
  background: var(--color-primary, #FF6B9D);
  color: #fff;
}
.qq-room-mode-hint {
  font-size: 11px;
  color: var(--color-muted, #999);
  margin-left: auto;
