  top: 8px;
  right: 8px;
  padding: 2px 10px;
  border: 1px solid #ddd;
  background: #fff;
  border-radius: 10px;
  font-size: 11px;
  color: #e95656;
  cursor: pointer;
}

/* ===== 世界书 ===== */
.worldbook-item {
  padding: 12px;
  background: #fff;
  border-radius: 10px;
  margin-bottom: 8px;
  border-left: 3px solid var(--color-primary, #FF6B9D);
}
.wb-name { font-size: 15px; font-weight: 600; }
.wb-desc { font-size: 13px; color: #999; margin-top: 4px; }
.wb-entry-count { font-size: 11px; color: var(--color-primary, #FF6B9D); margin-top: 4px; }

