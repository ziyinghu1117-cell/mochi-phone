    <script>
/* ===== auth.js ===== */
let authToken = localStorage.getItem('mochi_auth_token') || '';
let authUser = null;
let isAuthMode = 'login';

const showAuthPage = () => {
  const el = document.getElementById('authPage');
  if (el) { el.style.display = 'flex'; el.style.alignItems = 'center'; el.style.justifyContent = 'center'; }
};

const hideAuthPage = () => {
  const el = document.getElementById('authPage');
  if (el) el.style.display = 'none';
};

const toggleAuthMode = () => {
  isAuthMode = isAuthMode === 'login' ? 'register' : 'login';
  document.getElementById('authSubmitBtn').textContent = isAuthMode === 'login' ? '登录' : '注册';
  document.getElementById('authSubtitle').textContent = isAuthMode === 'login' ? '登录以继续' : '创建新账号';
  document.getElementById('authToggleText').innerHTML = isAuthMode === 'login'
    ? '没有账号？<span style="color:#FF6B9D">去注册</span>'
    : '已有账号？<span style="color:#FF6B9D">去登录</span>';
  document.getElementById('authError').style.display = 'none';
  /* 注册模式显示确认密码，登录模式隐藏 */
  const confirmEl = document.getElementById('authPasswordConfirm');
  if (confirmEl) {
    confirmEl.style.display = isAuthMode === 'register' ? 'block' : 'none';
    confirmEl.value = '';
  }
};

const handleAuth = async () => {
  const username = document.getElementById('authUsername').value.trim();
  const password = document.getElementById('authPassword').value;
  const errEl = document.getElementById('authError');
  const btn = document.getElementById('authSubmitBtn');
  if (!username || !password) { errEl.textContent = '请输入用户名和密码'; errEl.style.display = 'block'; return; }
  /* 注册时验证确认密码 */
  if (isAuthMode === 'register') {
    const confirmPwd = document.getElementById('authPasswordConfirm')?.value || '';
    if (password !== confirmPwd) { errEl.textContent = '两次输入的密码不一致'; errEl.style.display = 'block'; return; }
  }
  btn.disabled = true; btn.textContent = '处理中...';
  try {
    const endpoint = isAuthMode === 'login' ? '/api/auth/login' : '/api/auth/register';
    const resp = await fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username, password })
    });
    const data = await resp.json();
    if (data.code !== 0) throw new Error(data.message);
    authToken = data.data.token;
    authUser = data.data;
    /* 如果切换了账号，清除旧账号的本地状态 */
    const oldUserId = localStorage.getItem('mochi_phone_user_id');
    if (oldUserId && oldUserId !== data.data.userId) {
      localStorage.removeItem('commercial_ai_role_chat_state_v1');
      ['following', 'recommended', 'gossip'].forEach(function(t) {
        localStorage.removeItem('sf_posts_' + t);
      });
      localStorage.removeItem('sf_user_profile');
      localStorage.removeItem('sf_followed_roles');
      localStorage.removeItem('mochi_mock_state');
    }
    localStorage.setItem('mochi_auth_token', authToken);
    localStorage.setItem('mochi_phone_user_id', data.data.userId);
    /* 管理员登录后直接进入管理后台，普通用户进入主页 */
    if (data.data.isAdmin) {
      window.location.href = '/admin?token=' + encodeURIComponent(data.data.token);
      return;
    }
    hideAuthPage();
    location.reload();
  } catch (e) {
    errEl.textContent = e.message; errEl.style.display = 'block';
    btn.disabled = false; btn.textContent = isAuthMode === 'login' ? '登录' : '注册';
  }
};

const enterAsGuest = () => { hideAuthPage(); };

const checkAuth = async () => {
  if (!authToken) { showAuthPage(); return false; }
  try {
    const resp = await fetch('/api/auth/me', { headers: { 'x-session-token': authToken } });
    const data = await resp.json();
    if (data.code === 0 && data.data.loggedIn) {
      authUser = data.data;
      return true;
    }
    localStorage.removeItem('mochi_auth_token');
    authToken = '';
    showAuthPage();
    return false;
  } catch {
    showAuthPage();
    return false;
  }
};

/* 为所有 fetch 请求添加 session token */
const originalFetch = window.fetch;
window.fetch = function(...args) {
  if (authToken && args[0] && typeof args[0] === 'string' && args[0].startsWith('/api/')) {
    if (!args[1]) args[1] = {};
    if (!args[1].headers) args[1].headers = {};
    /* 确保 session token 始终发送 */
    if (!args[1].headers['x-session-token']) args[1].headers['x-session-token'] = authToken;
    /* 覆盖所有大小写变体的 x-user-id，确保用正确的登录用户 ID */
    if (authUser) {
      args[1].headers['x-user-id'] = authUser.userId;
      args[1].headers['X-User-Id'] = authUser.userId;
    }
  }
  return originalFetch.apply(this, args);
};

/* ===== config.js ===== */
const getOrCreateUserId = () => {
  let userId = localStorage.getItem('mochi_phone_user_id');
  if (!userId) {
    userId = `user_${Date.now()}_${Math.random().toString(36).slice(2, 10)}`;
    localStorage.setItem('mochi_phone_user_id', userId);
  }
  return userId;
};

/* 全局工具函数 */
window.toast = function(msg) {
  var t = document.getElementById('chatToast');
  if (!t) {
    t = document.createElement('div');
    t.id = 'chatToast';
    t.style.cssText = 'position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.75);color:#fff;padding:8px 20px;border-radius:20px;font-size:13px;z-index:99999;transition:opacity 0.3s';
    document.body.appendChild(t);
  }
  t.textContent = msg;
  t.style.opacity = '1';
  t.style.display = 'block';
  clearTimeout(t._timer);
  t._timer = setTimeout(function() {
    t.style.opacity = '0';
    setTimeout(function() { t.style.display = 'none'; }, 300);
  }, 2500);
};

window.uuid = function() {
  return 'id_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
};
    </script>

