.sf-detail-overlay{position:fixed;inset:0;z-index:210;background:#FFF5F7;display:none;flex-direction:column;max-width:430px;margin:0 auto}
.sf-detail-overlay.active{display:flex}
.sf-detail-header{display:flex;align-items:center;gap:12px;padding:10px 14px;border-bottom:1px solid rgba(0,0,0,.06);position:sticky;top:0;background:#ffffff;backdrop-filter:blur(18px);z-index:5}
.sf-detail-header span{color:#333333;font-size:16px;font-weight:700}
.sf-detail-body{flex:1;overflow-y:auto;padding:14px}
.sf-comment-bar{display:flex;gap:8px;padding:10px 14px;background:rgba(255,255,255,.95);backdrop-filter:blur(18px);border-top:1px solid rgba(0,0,0,.06)}
.sf-comment-bar input{flex:1;padding:10px 14px;border-radius:999px;background:#fff;border:1px solid rgba(0,0,0,.1);color:#333;font:inherit;font-size:14px;outline:none}
.sf-comment-bar input:focus{border-color:#FF6B9D}
.sf-comment-bar button{padding:8px 16px;border-radius:999px;background:#FF6B9D;color:#fff;border:0;font-weight:600;cursor:pointer}
.sf-comment{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid rgba(0,0,0,.06)}
.sf-comment-avatar{width:36px;height:36px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px;font-weight:700}
