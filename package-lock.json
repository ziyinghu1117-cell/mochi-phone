.sf-comment-name{color:#333333;font-size:13px;font-weight:600}
.sf-comment-text{color:#333333;font-size:14px;line-height:1.5;margin-top:2px}
.sf-comment-time{color:#999999;font-size:11px;margin-top:2px}
.sf-trend-card{margin:12px 14px;padding:14px;border-radius:16px;background:rgba(255,107,157,.04);border:1px solid rgba(255,107,157,.1)}
