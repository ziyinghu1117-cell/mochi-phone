<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Mochi-phone 管理后台</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#f0f2f5;color:#333;min-height:100vh}
.login-wrap{display:flex;align-items:center;justify-content:center;min-height:100vh;background:linear-gradient(135deg,#667eea 0%,#764ba2 100%)}
.login-card{background:#fff;border-radius:16px;padding:40px;width:360px;text-align:center;box-shadow:0 8px 32px rgba(0,0,0,0.1)}
.login-card h1{font-size:24px;margin-bottom:8px;color:#333}
.login-card p{color:#999;margin-bottom:24px;font-size:14px}
.login-card input{width:100%;padding:12px 16px;border:2px solid #e8e8e8;border-radius:10px;font-size:16px;margin-bottom:16px;transition:border-color 0.3s}
.login-card input:focus{border-color:#667eea;outline:none}
.login-card button{width:100%;padding:12px;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:10px;font-size:16px;cursor:pointer;transition:opacity 0.3s}
.login-card button:hover{opacity:0.9}
.header{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;padding:20px 24px;display:flex;align-items:center;justify-content:space-between}
.header h1{font-size:20px}
.header button{background:rgba(255,255,255,0.2);color:#fff;border:none;padding:8px 16px;border-radius:8px;cursor:pointer;font-size:14px}
.container{max-width:1200px;margin:0 auto;padding:20px}
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:24px}
.stat-card{background:#fff;border-radius:12px;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,0.06)}
.stat-card .label{font-size:13px;color:#999;margin-bottom:4px}
.stat-card .value{font-size:28px;font-weight:700;color:#333}
.stat-card.pending .value{color:#ff9800}
.stat-card.approved .value{color:#4caf50}
.stat-card.rejected .value{color:#f44336}
.stat-card.total .value{color:#667eea}
.panel{background:#fff;border-radius:12px;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,0.06);margin-bottom:20px}
.panel h2{font-size:18px;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid #f0f0f0}
.tabs{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap}
.tab{padding:8px 16px;border-radius:20px;background:#f5f5f5;cursor:pointer;font-size:14px;border:none;transition:all 0.2s}
.tab.active{background:#667eea;color:#fff}
.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:14px}
th{background:#f9f9f9;padding:12px;text-align:left;font-weight:600;color:#666;white-space:nowrap}
td{padding:12px;border-bottom:1px solid #f5f5f5}
tr:hover td{background:#fafbfc}
.badge{display:inline-block;padding:4px 10px;border-radius:12px;font-size:12px;font-weight:600}
.badge.pending{background:#fff3e0;color:#ff9800}
.badge.approved{background:#e8f5e9;color:#4caf50}
.badge.rejected{background:#ffebee;color:#f44336}
.actions{display:flex;gap:8px}
.btn-approve{background:#4caf50;color:#fff;border:none;padding:6px 14px;border-radius:6px;cursor:pointer;font-size:13px}
.btn-approve:hover{background:#43a047}
.btn-reject{background:#f44336;color:#fff;border:none;padding:6px 14px;border-radius:6px;cursor:pointer;font-size:13px}
.btn-reject:hover{background:#e53935}
.btn-detail{background:#2196f3;color:#fff;border:none;padding:6px 14px;border-radius:6px;cursor:pointer;font-size:13px}
.btn-detail:hover{background:#1976d2}
.note-input{width:100%;padding:8px;border:1px solid #ddd;border-radius:6px;font-size:13px;margin:8px 0;resize:vertical}
.modal-overlay{position:fixed;inset:0;z-index:10000;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,0.5)}
.modal-overlay.show{display:flex}
.modal{background:#fff;border-radius:16px;padding:24px;max-width:480px;width:90%;max-height:80vh;overflow-y:auto}
.modal h3{margin-bottom:16px;color:#333}
.modal .info-row{display:flex;padding:8px 0;border-bottom:1px solid #f5f5f5;font-size:14px}
.modal .info-row .label{width:100px;color:#999;flex-shrink:0}
.modal .info-row .value{flex:1;word-break:break-all}
.toast{position:fixed;top:20px;right:20px;padding:12px 24px;border-radius:8px;color:#fff;font-size:14px;z-index:99999;animation:slideIn 0.3s ease}
.toast.success{background:#4caf50}
.toast.error{background:#f44336}
@keyframes slideIn{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}
.empty{text-align:center;padding:40px;color:#999;font-size:14px}
.hidden{display:none !important}
</style>
</head>
<body>
<div id="loginPage" class="login-wrap">
<div class="login-card">
<h1>Mochi-phone</h1>
<p>管理员后端</p>
<input id="passwordInput" type="password" placeholder="请输入管理员密码" onkeydown="if(event.key==='Enter')doLogin()">
<button onclick="doLogin()">登录</button>
<p id="loginError" style="color:#f44336;font-size:13px;display:none;margin-top:12px"></p>
</div>
</div>
<div id="adminPage" class="hidden">
<div class="header">
<h1>Mochi-phone 管理后台</h1>
<div style="display:flex;gap:8px">
<button onclick="window.location.href='/'" style="background:rgba(255,255,255,0.2);color:#fff;border:none;padding:8px 16px;border-radius:8px;cursor:pointer;font-size:14px">返回主页</button>
<button onclick="doLogout()">退出登录</button>
</div>
</div>
<div class="container">
<div class="stats-grid" id="statsGrid"></div>
<div class="panel">
<h2>官方人设管理</h2>
<button class="btn-approve" onclick="showRoleUploader()">+ 上传官方人设</button>
<div id="adminRolesList" style="margin-top:12px"></div>
</div>
<div class="panel">
<h2>文游剧本管理</h2>
<button class="btn-approve" onclick="showNovelUploader()">+ 上传文游剧本</button>
<div id="adminNovelsList" style="margin-top:12px"></div>
</div>
<div class="panel">
<h2>充值订单管理</h2>
<div class="tabs" id="filterTabs">
<button class="tab active" data-filter="all">全部</button>
<button class="tab" data-filter="pending">待审核</button>
<button class="tab" data-filter="approved">已通过</button>
<button class="tab" data-filter="rejected">已拒绝</button>
</div>
<div class="table-wrap">
<table>
<thead><tr><th>用户ID</th><th>金额</th><th>豆子</th><th>交易号</th><th>状态</th><th>提交时间</th><th>操作</th></tr></thead>
<tbody id="verificationsBody"></tbody>
</table>
</div>
<div id="emptyState" class="empty hidden">暂无订单数据</div>
</div>
</div>
</div>
<div id="detailModal" class="modal-overlay">
<div class="modal">
<h3>订单详情</h3>
<div id="detailContent"></div>
<div style="margin-top:16px;display:flex;gap:8px">
<button class="btn-approve" id="modalApproveBtn" onclick="modalAction('approve')">通过并发豆</button>
<button class="btn-reject" id="modalRejectBtn" onclick="modalAction('reject')">拒绝</button>
<button style="flex:1;background:#f5f5f5;border:none;padding:8px 16px;border-radius:6px;cursor:pointer" onclick="closeModal()">关闭</button>
</div>
</div>
</div>
<script>
const API_BASE = location.origin;
let adminToken = localStorage.getItem('adminToken') || '';
let currentFilter = 'all';
let allVerifications = [];

function apiRequest(path, options = {}) {
  return fetch(API_BASE + '/api' + path, {
    ...options,
    headers: { 'Content-Type': 'application/json', 'x-admin-token': adminToken, ...(options.headers || {}) }
  }).then(r => r.json());
}

function showToast(msg, type = 'success') {
  const t = document.createElement('div');
  t.className = 'toast ' + type;
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3000);
}

async function doLogin() {
  const pwd = document.getElementById('passwordInput').value;
  const errEl = document.getElementById('loginError');
  try {
    const res = await apiRequest('/admin/login', { method: 'POST', body: JSON.stringify({ password: pwd }) });
    if (res.code === 0) {
      adminToken = res.data.token;
      localStorage.setItem('adminToken', adminToken);
      document.getElementById('loginPage').classList.add('hidden');
      document.getElementById('adminPage').classList.remove('hidden');
      loadDashboard();
    } else {
      errEl.textContent = res.message;
      errEl.style.display = 'block';
    }
  } catch(e) {
    errEl.textContent = '网络错误';
    errEl.style.display = 'block';
  }
}

function doLogout() {
  adminToken = '';
  localStorage.removeItem('adminToken');
  document.getElementById('loginPage').classList.remove('hidden');
  document.getElementById('adminPage').classList.add('hidden');
}

async function loadAdminRoles() {
  try {
    const res = await apiRequest('/admin/roles');
    if (res.code === 0) {
      const list = res.data.list || [];
      document.getElementById('adminRolesList').innerHTML = list.length === 0
        ? '<div class="empty">暂无官方人设</div>'
        : list.map(r => '<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #f5f5f5"><span>' + r.name + '</span><button class="btn-reject" onclick="deleteAdminRole(\\''+r.id+'\\')">删除</button></div>').join('');
    }
  } catch(e) {}
}

function showRoleUploader() {
  const existing = document.getElementById('roleUploaderModal');
  if (existing) existing.remove();
  const modal = document.createElement('div');
  modal.id = 'roleUploaderModal';
  modal.className = 'modal-overlay show';
  modal.innerHTML = '<div class="modal" style="max-width:600px">'+
    '<h3 style="margin-bottom:16px">上传官方人设</h3>'+
    '<div style="margin-bottom:12px"><label style="display:block;font-size:13px;color:#666;margin-bottom:4px">人设名称</label>'+
    '<input id="ruName" type="text" style="width:100%;padding:10px;border:1px solid #ddd;border-radius:8px;font-size:14px" placeholder="请输入人设名称"></div>'+
    '<div style="margin-bottom:12px"><label style="display:block;font-size:13px;color:#666;margin-bottom:4px">人设 Prompt（角色设定）</label>'+
    '<textarea id="ruPrompt" rows="8" style="width:100%;padding:10px;border:1px solid #ddd;border-radius:8px;font-size:14px;resize:vertical;font-family:inherit" placeholder="请输入角色设定 Prompt..."></textarea></div>'+
    '<div style="display:flex;gap:12px;margin-bottom:12px"><div style="flex:1"><label style="display:block;font-size:13px;color:#666;margin-bottom:4px">头像 URL（可留空）</label>'+
    '<input id="ruAvatar" type="text" style="width:100%;padding:10px;border:1px solid #ddd;border-radius:8px;font-size:14px" placeholder="头像图片链接"></div>'+
    '<div style="flex:1"><label style="display:block;font-size:13px;color:#666;margin-bottom:4px">标签（逗号分隔）</label>'+
    '<input id="ruTags" type="text" style="width:100%;padding:10px;border:1px solid #ddd;border-radius:8px;font-size:14px" placeholder="标签1,标签2"></div></div>'+
    '<div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px">'+
    '<button onclick="this.parentElement.parentElement.remove()" style="padding:8px 20px;border:1px solid #ddd;border-radius:8px;cursor:pointer;font-size:14px;background:#fff">取消</button>'+
    '<button id="ruSubmit" onclick="submitRoleUpload()" style="padding:8px 20px;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:14px">发布</button></div>'+
    '</div>';
  document.body.appendChild(modal);
}

function submitRoleUpload() {
  const name = document.getElementById('ruName').value.trim();
  const promptText = document.getElementById('ruPrompt').value.trim();
  const avatar = document.getElementById('ruAvatar').value.trim();
  const tagsStr = document.getElementById('ruTags').value.trim();
  if (!name) { showToast('请输入人设名称', 'error'); return; }
  if (!promptText) { showToast('请输入人设Prompt', 'error'); return; }
  const tags = tagsStr ? tagsStr.split(',').map(t=>t.trim()).filter(Boolean) : [];
  const btn = document.getElementById('ruSubmit');
  btn.disabled = true; btn.textContent = '发布中...';
  fetch(API_BASE + '/api/admin/roles', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'x-admin-token': adminToken },
    body: JSON.stringify({ name, description: '', prompt: promptText, avatar, tags })
  }).then(r=>r.json()).then(res => {
    if (res.code === 0) { showToast('人设已发布'); document.getElementById('roleUploaderModal').remove(); loadAdminRoles(); }
    else { showToast(res.message, 'error'); btn.disabled = false; btn.textContent = '发布'; }
  }).catch(() => { showToast('网络错误', 'error'); btn.disabled = false; btn.textContent = '发布'; });
}

function deleteAdminRole(id) {
  if (!confirm('确认删除此人设？')) return;
  fetch(API_BASE + '/api/admin/roles/' + id, { method: 'DELETE', headers: { 'x-admin-token': adminToken } })
    .then(r=>r.json()).then(res => { if (res.code === 0) { showToast('已删除'); loadAdminRoles(); } });
}

async function loadAdminNovels() {
  try {
    const res = await apiRequest('/admin/novel-games');
    if (res.code === 0) {
      const list = res.data.list || [];
      document.getElementById('adminNovelsList').innerHTML = list.length === 0
        ? '<div class="empty">暂无文游剧本</div>'
        : list.map(n => '<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #f5f5f5"><span>'+n.name+' ('+n.category+')</span><button class="btn-reject" onclick="deleteAdminNovel(\\''+n.id+'\\')">删除</button></div>').join('');
    }
  } catch(e) {}
}

function showNovelUploader() {
  const existing = document.getElementById('novelUploaderModal');
  if (existing) existing.remove();
  const modal = document.createElement('div');
  modal.id = 'novelUploaderModal';
  modal.className = 'modal-overlay show';
  modal.innerHTML = '<div class="modal" style="max-width:700px">'+
    '<h3 style="margin-bottom:16px">上传文游剧本</h3>'+
    '<label style="display:block;font-size:13px;color:#666;margin-bottom:4px">请粘贴文游剧本 JSON（包含 id, name, category, systemPrompt 等字段）</label>'+
    '<textarea id="nuJson" rows="16" style="width:100%;padding:10px;border:1px solid #ddd;border-radius:8px;font-size:13px;resize:vertical;font-family:monospace" placeholder="粘贴 JSON 内容..."></textarea>'+
    '<div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px">'+
    '<button onclick="this.parentElement.parentElement.remove()" style="padding:8px 20px;border:1px solid #ddd;border-radius:8px;cursor:pointer;font-size:14px;background:#fff">取消</button>'+
    '<button id="nuSubmit" onclick="submitNovelUpload()" style="padding:8px 20px;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:14px">上传</button></div>'+
    '</div>';
  document.body.appendChild(modal);
}

function submitNovelUpload() {
  const jsonStr = document.getElementById('nuJson').value.trim();
  if (!jsonStr) { showToast('请粘贴JSON内容', 'error'); return; }
  const btn = document.getElementById('nuSubmit');
  btn.disabled = true; btn.textContent = '上传中...';
  try {
    const script = JSON.parse(jsonStr);
    fetch(API_BASE + '/api/admin/novel-games', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-admin-token': adminToken },
      body: JSON.stringify({ script })
    }).then(r=>r.json()).then(res => {
      if (res.code === 0) { showToast('文游剧本已上传'); document.getElementById('novelUploaderModal').remove(); loadAdminNovels(); }
      else { showToast(res.message, 'error'); btn.disabled = false; btn.textContent = '上传'; }
    }).catch(() => { showToast('网络错误', 'error'); btn.disabled = false; btn.textContent = '上传'; });
  } catch(e) { showToast('JSON格式错误', 'error'); btn.disabled = false; btn.textContent = '上传'; }
}

function deleteAdminNovel(id) {
  if (!confirm('确认删除此剧本？')) return;
  fetch(API_BASE + '/api/admin/novel-games/' + id, { method: 'DELETE', headers: { 'x-admin-token': adminToken } })
    .then(r=>r.json()).then(res => { if (res.code === 0) { showToast('已删除'); loadAdminNovels(); } });
}

async function loadDashboard() {
  try {
    const [statsRes, verRes] = await Promise.all([
      apiRequest('/admin/stats'),
      apiRequest('/admin/verifications?status=' + currentFilter)
    ]);
    if (statsRes.code === 0) renderStats(statsRes.data);
    if (verRes.code === 0) { allVerifications = verRes.data.list; renderVerifications(); }
    loadAdminRoles();
    loadAdminNovels();
  } catch(e) { showToast('加载数据失败', 'error'); }
}

function renderStats(s) {
  document.getElementById('statsGrid').innerHTML =
    '<div class="stat-card total"><div class="label">总订单</div><div class="value">' + s.totalVerifications + '</div></div>' +
    '<div class="stat-card pending"><div class="label">待审核</div><div class="value">' + s.pendingCount + '</div></div>' +
    '<div class="stat-card approved"><div class="label">已通过</div><div class="value">' + s.approvedCount + '</div></div>' +
    '<div class="stat-card rejected"><div class="label">已拒绝</div><div class="value">' + s.rejectedCount + '</div></div>' +
    '<div class="stat-card"><div class="label">总收入(元)</div><div class="value">' + s.totalRechargeCny + '</div></div>' +
    '<div class="stat-card"><div class="label">用户数</div><div class="value">' + s.userCount + '</div></div>';
}

function renderVerifications() {
  const tbody = document.getElementById('verificationsBody');
  const empty = document.getElementById('emptyState');
  if (allVerifications.length === 0) {
    tbody.innerHTML = '';
    empty.classList.remove('hidden');
    return;
  }
  empty.classList.add('hidden');
  tbody.innerHTML = allVerifications.map(v => {
    const time = new Date(v.createdAt).toLocaleString('zh-CN');
    const badgeClass = v.status;
    const statusText = v.status === 'pending' ? '待审核' : v.status === 'approved' ? '已通过' : '已拒绝';
    const actions = v.status === 'pending'
      ? '<button class="btn-approve" onclick="quickAction(\\'' + v.id + '\\',\\'approve\\')">通过</button><button class="btn-reject" onclick="quickAction(\\'' + v.id + '\\',\\'reject\\')">拒绝</button>'
      : '<button class="btn-detail" onclick="showDetail(\\'' + v.id + '\\')">详情</button>';
    return '<tr><td style="max-width:80px;overflow:hidden;text-overflow:ellipsis" title="' + v.userId + '">' + v.userId + '</td><td>' + v.amount + '元</td><td>' + v.beans + '</td><td style="max-width:120px;overflow:hidden;text-overflow:ellipsis" title="' + (v.transactionId||'') + '">' + (v.transactionId||'-') + '</td><td><span class="badge ' + badgeClass + '">' + statusText + '</span></td><td style="white-space:nowrap;font-size:12px">' + time + '</td><td class="actions">' + actions + '</td></tr>';
  }).join('');
}

async function quickAction(id, action) {
  try {
    const res = await apiRequest('/admin/verifications/' + id + '/' + action, {
      method: 'POST',
      body: JSON.stringify({ note: '' })
    });
    if (res.code === 0) {
      showToast(action === 'approve' ? '已通过，豆子已发放' : '已拒绝');
      loadDashboard();
    } else {
      showToast(res.message, 'error');
    }
  } catch(e) { showToast('操作失败', 'error'); }
}

let currentDetailId = null;
function showDetail(id) {
  currentDetailId = id;
  const v = allVerifications.find(x => x.id === id);
  if (!v) return;
  document.getElementById('detailContent').innerHTML =
    '<div class="info-row"><div class="label">订单ID</div><div class="value">' + v.id + '</div></div>' +
    '<div class="info-row"><div class="label">用户ID</div><div class="value">' + v.userId + '</div></div>' +
    '<div class="info-row"><div class="label">金额</div><div class="value">' + v.amount + ' 元</div></div>' +
    '<div class="info-row"><div class="label">豆子</div><div class="value">' + v.beans + '</div></div>' +
    '<div class="info-row"><div class="label">交易号</div><div class="value">' + (v.transactionId || '-') + '</div></div>' +
    '<div class="info-row"><div class="label">状态</div><div class="value"><span class="badge ' + v.status + '">' + v.status + '</span></div></div>' +
    '<div class="info-row"><div class="label">提交时间</div><div class="value">' + new Date(v.createdAt).toLocaleString('zh-CN') + '</div></div>' +
    (v.reviewedAt ? '<div class="info-row"><div class="label">审核时间</div><div class="value">' + new Date(v.reviewedAt).toLocaleString('zh-CN') + '</div></div>' : '') +
    (v.reviewNote ? '<div class="info-row"><div class="label">审核备注</div><div class="value">' + v.reviewNote + '</div></div>' : '') +
    '<div style="margin-top:12px"><label style="font-size:13px;color:#666">审核备注：</label><textarea id="modalNoteInput" class="note-input" rows="2" placeholder="可选填备注"></textarea></div>';
  const approveBtn = document.getElementById('modalApproveBtn');
  const rejectBtn = document.getElementById('modalRejectBtn');
  if (v.status === 'pending') {
    approveBtn.classList.remove('hidden');
    rejectBtn.classList.remove('hidden');
  } else {
    approveBtn.classList.add('hidden');
    rejectBtn.classList.add('hidden');
  }
  document.getElementById('detailModal').classList.add('show');
}

function closeModal() { document.getElementById('detailModal').classList.remove('show'); }

async function modalAction(action) {
  if (!currentDetailId) return;
  const note = document.getElementById('modalNoteInput').value;
  try {
    const res = await apiRequest('/admin/verifications/' + currentDetailId + '/' + action, {
      method: 'POST',
      body: JSON.stringify({ note })
    });
    if (res.code === 0) {
      showToast(action === 'approve' ? '已通过，豆子已发放' : '已拒绝');
      closeModal();
      loadDashboard();
    } else {
      showToast(res.message, 'error');
    }
  } catch(e) { showToast('操作失败', 'error'); }
}

document.getElementById('filterTabs').addEventListener('click', e => {
  const tab = e.target.closest('.tab');
  if (!tab) return;
  document.querySelectorAll('#filterTabs .tab').forEach(t => t.classList.remove('active'));
  tab.classList.add('active');
  currentFilter = tab.dataset.filter;
  loadDashboard();
});

/* Auto-login: 优先用 URL 参数中的 auth token 自动登录 */
const urlParams = new URLSearchParams(window.location.search);
const urlAuthToken = urlParams.get('token');
if (urlAuthToken) {
  /* 用 auth token 换取 admin token */
  fetch(API_BASE + '/api/admin/login', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ authToken: urlAuthToken })
  }).then(r => r.json()).then(res => {
    if (res.code === 0) {
      adminToken = res.data.token;
      localStorage.setItem('adminToken', adminToken);
      /* 清除 URL 中的 token 参数 */
      window.history.replaceState({}, '', '/admin');
      document.getElementById('loginPage').classList.add('hidden');
      document.getElementById('adminPage').classList.remove('hidden');
      loadDashboard();
    } else {
      /* auth token 无效，显示登录页 */
      localStorage.removeItem('adminToken');
    }
  }).catch(() => {});
} else if (adminToken) {
  document.getElementById('loginPage').classList.add('hidden');
  document.getElementById('adminPage').classList.remove('hidden');
  loadDashboard();
}
</script>
</body>
</html>