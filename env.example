# Mochi AI Chat 环境变量配置
# 复制此文件为 .env 并填入实际值

# ==================== API 配置（必填） ====================

# OpenAI 兼容 API 地址
# 支持两种格式：
#   1. 带 /v1 结尾：https://api.openai.com/v1
#   2. 不带 /v1：https://api.openai.com
# 系统会自动智能拼接正确的请求路径
API_BASE_URL=https://api.openai.com/v1

# API 密钥
API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 模型名称（默认 gpt-3.5-turbo）
MODEL=gpt-3.5-turbo

# ==================== 管理员配置 ====================

# 管理员后台密码（默认 841026）
# 管理员后台地址：/admin
ADMIN_PASSWORD=841026

# ==================== 系统配置（可选） ====================

# 服务端口（默认 3000，Render 会自动设置）
PORT=3000

# 新用户注册赠送米粒数（默认 1000）
INITIAL_RICE=1000

# 每 1000 token 消耗米粒数（默认 1）
RICE_PER_1K_TOKENS=1

# ==================== 充值档位配置（可选） ====================
# 格式：价格:米粒数:赠送米粒数，多个用逗号分隔
# 例如：10:1000:0,30:3000:500,50:5000:1000,100:10000:3000
RECHARGE_TIERS=10:1000:0,30:3000:500,50:5000:1000,100:10000:3000
