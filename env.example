# Mochi AI Chat 环境变量配置
# 复制此文件为 .env 并填入实际值

# ==================== API 配置（必填） ====================
# OpenAI 兼容 API 地址
# 支持两种格式：
#   1. 带 /v1 结尾：https://api.openai.com/v1
#   2. 不带 /v1：https://api.openai.com
# 系统会自动智能拼接正确的请求路径
API_BASE_URL=https://api.openai.com/v1

# API 密钥
API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 模型名称（默认 gpt-3.5-turbo）
MODEL=gpt-3.5-turbo

# ==================== 管理员配置 ====================
# 管理员后台密码（默认 841026）
# 管理员后台地址：/admin
ADMIN_PASSWORD=841026

# ==================== 系统配置（可选） ====================
# 服务端口（默认 3000，Render 会自动设置）
PORT=3000

# 运行环境
NODE_ENV=production

# JWT 密钥（建议修改为随机字符串）
JWT_SECRET=mochi_ai_chat_default_secret_2024

# JWT 有效期（秒，默认 7 天 = 604800 秒）
JWT_EXPIRES_IN=604800

# 数据存储目录（默认 ./data）
DATA_DIR=./data

# 新用户注册赠送米粒数（默认 1000）
INITIAL_RICE=1000

# 每 1000 token 消耗米粒数（默认 1）
RICE_PER_1K_TOKENS=1

# ==================== 论坛配置（可选） ====================
# 生成帖子消耗米粒数（默认 2）
FORUM_POST_COST=2

# 生成评论消耗米粒数（默认 1）
FORUM_COMMENT_COST=1

# 论坛单页加载数量（默认 10）
FORUM_PAGE_SIZE=10

# ==================== 同人文配置（可选） ====================
# 生成同人文消耗米粒数（默认 10）
FANFIC_COST=10

# 同人文单页加载数量（默认 12）
FANFIC_PAGE_SIZE=12

# ==================== 社区配置（可选） ====================
# 社区角色单页加载数量（默认 20）
COMMUNITY_PAGE_SIZE=20

# ==================== 充值档位配置（可选） ====================
# 格式：价格:米粒数:赠送米粒数，多个用逗号分隔
# 例如：1:10:0,6:60:0,12:120:5,30:300:20,50:500:50,68:680:80,98:980:150,128:1280:200,198:1980:400,328:3280:800,648:6480:2000
RECHARGE_TIERS=1:10:0,6:60:0,12:120:5,30:300:20,50:500:50,68:680:80,98:980:150,128:1280:200,198:1980:400,328:3280:800,648:6480:2000

# 支付渠道（默认 manual，手动审核）
PAY_CHANNEL=manual
