# === Mochi-phone 环境变量 ===

# 服务器端口（Render 会自动设置 PORT）
PORT=3000

# AI 上游 API 密钥（必填，替换为你的真实密钥）
UPSTREAM_API_KEY=sk-your-real-api-key-here

# 聊天每次消耗的豆子数
CHAT_BEANS_COST=2

# 每元兑换豆子数
BEANS_PER_CNY=10

# 充值套餐：金额:豆子,金额:豆子
RECHARGE_PACKAGES=6:60,18:200,30:360,68:900

# 新用户初始豆子数
DEMO_INITIAL_BEANS=30

# 管理员密码（默认 841026，建议修改为复杂密码）
ADMIN_PASSWORD=841026

# PostgreSQL 数据库（Render 部署时自动提供 DATABASE_URL）
# 未设置时回退到本地 JSON 文件存储
DATABASE_URL=

# PostgreSQL SSL 设置
PG_SSL=true
